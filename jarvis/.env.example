# Jarvis reads ../backend/.env automatically, so you only need this file
# if you want different keys or settings. Both providers have free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
JARVIS_NAME=Jarvis
JARVIS_PORT=7777
JARVIS_GROQ_MODEL=openai/gpt-oss-120b
JARVIS_GEMINI_MODEL=gemini-3.5-flash-lite
